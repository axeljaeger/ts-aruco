{
  "$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**/*.ts",
      "scripts/**/*.mjs",
      "tests/**/*.ts",
      "site/src/**/*.ts",
      "site/src/**/*.css",
      "vite.config.ts",
      "tests/**/*.js",
      "tests/**/*.mjs",
      "playwright.config.ts",
      "*.json",
      "*.md"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "domains": {
      "project": "recommended",
      "test": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noAssignInExpressions": "off",
        "noImplicitAnyLet": "off",
        "noExplicitAny": "error",
        "noVar": "error"
      },
      "complexity": {
        "useArrowFunction": "off",
        "noForEach": "error",
        "useOptionalChain": "error"
      },
      "style": {
        "useImportType": "error",
        "useExportType": "error",
        "noNonNullAssertion": "error",
        "useConst": "error",
        "useTemplate": "error",
        "noParameterAssign": "error",
        "useForOf": "error",
        "useConsistentArrayType": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        },
        "noInferrableTypes": "error",
        "useNumberNamespace": "error",
        "useExponentiationOperator": "error",
        "noUselessElse": "error",
        "useShorthandAssign": "error",
        "useNodejsImportProtocol": "error",
        "useBlockStatements": "off",
        "noYodaExpression": "error",
        "useReadonlyClassProperties": "error"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "overrides": [
    {
      "includes": ["site/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ]
}
